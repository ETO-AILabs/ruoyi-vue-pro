<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.iocoder.boot</groupId>
        <artifactId>yudao</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>yudao-module-match</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        match 模块，MatchAI UP 的业务模块。
        包含：AI 分身（Avatar）、匹配推荐（Candidates）、喜欢/跳过（Like/Pass）、匹配结果（Results）、校园发现（部落/学校）。
        当前版本使用内存 Map 实现，后续可切换为真数据库（见 resources/sql/match.sql）。
    </description>

    <dependencies>
        <!-- Web / 安全 相关 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关（DO / Mapper 骨架依赖 MyBatis-Plus） -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

</project>
